---
import { asset, localRoute } from '@/lib/paths';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

interface Props {
  lang: Lang;
  culture?: string;
}

const { lang, culture } = Astro.props;
---

<footer>
  {t(lang, 'textLabel')} CC BY-SA · {t(lang, 'codeLabel')} MIT
  · <a href={asset(lang === 'fa' ? 'fa/rss.xml' : 'rss.xml')}>RSS</a>
  · <a href={localRoute(lang, 'about/')}>{t(lang, 'sources')}</a>
  · <button type="button" class="cookie-link" data-cookie-settings>{t(lang, 'cookieSettings')}</button>
  {culture && culture !== 'base' && <span class="cult-glyph" aria-hidden="true"></span>}
</footer>
