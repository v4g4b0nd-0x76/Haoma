---
import { asset } from '@/lib/paths';
import { t } from '@/lib/i18n';
import type { Lang } from '@/lib/types';

interface Props {
  src: string;
  title?: string;
  href?: string;
  compact?: boolean;
  lang: Lang;
}

const { src, title = '', href = '', compact = false, lang } = Astro.props;
const url = /^https?:/.test(src) ? src : asset(src);
---

<div class:list={['ha-player', compact && 'ha-player--compact']} data-ha-player>
  <audio preload="none" src={url}></audio>
  <button type="button" class="ha-player__play" data-ha-play aria-label={t(lang, 'listenPlay')}>
    <svg class="ha-player__ico ha-player__ico--play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.14v13.72L19 12 8 5.14z"/></svg>
    <svg class="ha-player__ico ha-player__ico--pause" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
  </button>
  <div class="ha-player__body">
    {title && (
      <div class="ha-player__meta">
        {href ? <a class="ha-player__title" href={href}>{title}</a> : <span class="ha-player__title">{title}</span>}
      </div>
    )}
    <div
      class="ha-player__track"
      data-ha-seek
      role="slider"
      tabindex="0"
      aria-label={t(lang, 'listenSeek')}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="ha-player__rail"><div class="ha-player__fill" data-ha-fill></div><div class="ha-player__knob" data-ha-knob></div></div>
    </div>
    <div class="ha-player__times"><span data-ha-cur>0:00</span><span data-ha-dur>—:—</span></div>
  </div>
</div>
