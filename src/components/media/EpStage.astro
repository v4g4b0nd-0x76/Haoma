---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Page } from '@/lib/types';
import { t } from '@/lib/i18n';
import { spotifyEmbed, youtubeId } from '@/lib/media';
import HaPlayer from './HaPlayer.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { lang, frontmatter: fm } = page;

const youtube = youtubeId(fm.youtube);
const spotify = spotifyEmbed(fm.spotify);
const audio =
  fm.audio && (/^https?:/.test(fm.audio) || existsSync(join(process.cwd(), 'static', fm.audio)))
    ? fm.audio
    : '';
---

{(youtube || spotify || audio) && (
  <section class="ep-stage" id="ep-watch" aria-label={t(lang, 'listen')}>
    {youtube ? (
      <div class="yt-card" data-yt-card data-yt-id={youtube}>
        <button type="button" class="yt-card__hit" data-yt-play aria-label={t(lang, 'watchPlay')}>
          <img
            class="yt-card__thumb"
            src={`https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
          <span class="yt-card__veil" aria-hidden="true"></span>
          <span class="yt-card__play" aria-hidden="true">
            <svg viewBox="0 0 68 48" width="68" height="48"><path class="yt-card__tri-bg" d="M66.5 7.7c-.8-2.9-2.5-5.4-5.4-6.2C55.8.1 34 0 34 0S12.2.1 6.9 1.5C4 2.3 2.3 4.8 1.5 7.7 0 13.1 0 24 0 24s0 10.9 1.5 16.3c.8 2.9 2.5 5.4 5.4 6.2C12.2 47.9 34 48 34 48s21.8-.1 27.1-1.5c2.9-.8 4.6-3.3 5.4-6.2C68 34.9 68 24 68 24s0-10.9-1.5-16.3z"/><path fill="#fff" d="M45 24 27 14v20"/></svg>
          </span>
          <span class="yt-card__badge">YouTube</span>
        </button>
      </div>
    ) : spotify ? (
      <div class="sp-card" data-sp-card>
        <iframe
          class="sp-card__frame"
          title={page.title}
          src={`https://open.spotify.com/embed/${spotify.type}/${spotify.id}?utm_source=generator&theme=0`}
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    ) : null}

    {audio && (
      <div class="ep-stage__audio">
        <span class="ep-stage__kicker">{t(lang, 'listenSticky')}</span>
        <HaPlayer src={audio} title={page.title} lang={lang} />
      </div>
    )}
  </section>
)}
