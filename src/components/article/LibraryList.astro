---
import type { Lang } from '@/lib/types';
import { libraryData } from '@/lib/data/library';
import { t } from '@/lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { entries, categories } = libraryData(lang);
const sorted = entries.slice().sort((a, b) => a.title.localeCompare(b.title));

const filterScript = `(function(){
  var root=document.querySelector("[data-lib]"); if(!root) return;
  var q=root.querySelector(".lib__q"), chips=root.querySelectorAll(".lib__chip[data-kind]");
  var catChips=root.querySelectorAll(".lib__chip[data-cat]");
  var items=[].slice.call(root.querySelectorAll(".files__item"));
  var empty=root.querySelector(".lib__empty");
  var kind="all", cat="";
  try{
    var u=new URL(location.href);
    var c=u.searchParams.get("cat")||"";
    if(c){cat=c;catChips.forEach(function(b){b.classList.toggle("is-on",(b.getAttribute("data-cat")||"")===c);});}
  }catch(e){}
  function run(){
    var t=(q&&q.value||"").toLowerCase().trim();
    var n=0;
    items.forEach(function(li){
      var okKind=kind==="all"||li.getAttribute("data-kind")===kind;
      var cats=(" "+(li.getAttribute("data-cats")||"")+" ");
      var okCat=!cat||cats.indexOf(" "+cat+" ")>=0;
      var hay=(li.getAttribute("data-title")||"")+" "+(li.getAttribute("data-name")||"");
      var okQ=!t||hay.indexOf(t)>=0;
      var on=okKind&&okCat&&okQ; li.hidden=!on; if(on)n++;
    });
    if(empty) empty.hidden=n>0;
  }
  if(q) q.addEventListener("input",run);
  chips.forEach(function(b){ b.addEventListener("click",function(){
    kind=b.getAttribute("data-kind")||"all";
    chips.forEach(function(c){ c.classList.toggle("is-on",c===b); });
    run();
  }); });
  catChips.forEach(function(b){ b.addEventListener("click",function(){
    cat=b.getAttribute("data-cat")||"";
    catChips.forEach(function(c){ c.classList.toggle("is-on",c===b); });
    run();
  }); });
  run();
})();`;
---

<div class="lib" data-lib>
  <div class="lib__bar">
    <label class="lib__search">
      <span class="visually-hidden">{t(lang, 'libraryFilter')}</span>
      <input type="search" class="lib__q" placeholder={t(lang, 'libraryFilter')} autocomplete="off" />
    </label>
    <div class="lib__chips" role="group" aria-label={t(lang, 'libraryFilter')}>
      <button type="button" class="lib__chip is-on" data-kind="all">{t(lang, 'libraryAll')}</button>
      <button type="button" class="lib__chip" data-kind="pdf">PDF</button>
      <button type="button" class="lib__chip" data-kind="image">{t(lang, 'libraryImage')}</button>
      <button type="button" class="lib__chip" data-kind="epub">{t(lang, 'libraryEpub')}</button>
      <button type="button" class="lib__chip" data-kind="md">{t(lang, 'libraryMd')}</button>
      <button type="button" class="lib__chip" data-kind="text">{t(lang, 'libraryText')}</button>
    </div>
    {categories.length > 0 && (
      <div class="lib__chips lib__chips--cat" role="group" aria-label={t(lang, 'libraryCategories')}>
        <button type="button" class="lib__chip is-on" data-cat="">{t(lang, 'libraryAllCats')}</button>
        {categories.map((category) => (
          <button type="button" class="lib__chip" data-cat={category.id}>{category.label}</button>
        ))}
      </div>
    )}
  </div>

  {sorted.length > 0 ? (
    <>
      <ul class="files">
        {sorted.map((entry) => (
          <li
            class="files__item"
            data-kind={entry.kind}
            data-name={entry.name.toLowerCase()}
            data-title={entry.title.toLowerCase()}
            data-cats={entry.cats.join(' ')}
          >
            <a href={entry.href}>
              <span class="files__title">{entry.title}</span>
              <span class="files__name muted">{entry.name}{entry.catLabels.length ? ` · ${entry.catLabels.join(', ')}` : ''}</span>
            </a>
            <span class="files__ext muted">{entry.ext}</span>
          </li>
        ))}
      </ul>
      <p class="lib__empty msg" hidden>{t(lang, 'libraryEmptyFilter')}</p>
    </>
  ) : (
    <p class="lib__empty msg">{t(lang, 'libraryEmpty')}</p>
  )}
</div>

<script is:inline set:html={filterScript}></script>
