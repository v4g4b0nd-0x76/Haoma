---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Page } from '@/lib/types';
import { getContent, resolvePath } from '@/lib/content/load';
import { localRoute } from '@/lib/paths';
import { t } from '@/lib/i18n';
import { youtubeId } from '@/lib/media';
import HaPlayer from '@/components/media/HaPlayer.astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { lang } = page;
const index = getContent();

type Episode = NonNullable<ReturnType<typeof resolvePath>>;
let episode: Episode | null = null;
let audio = '';
let youtube = '';

for (const related of page.frontmatter.related ?? []) {
  if (!related.startsWith('/episodes/')) continue;
  const candidate = resolvePath(index, lang, related);
  if (!candidate) continue;

  const candidateAudio = candidate.frontmatter.audio ?? '';
  const hasAudio =
    candidateAudio &&
    (/^https?:/.test(candidateAudio) || existsSync(join(process.cwd(), 'static', candidateAudio)));
  const candidateYoutube = youtubeId(candidate.frontmatter.youtube);

  if (hasAudio || candidateYoutube) {
    episode = candidate;
    audio = hasAudio ? candidateAudio : '';
    youtube = candidateYoutube ?? '';
    break;
  }
}
---

{episode && (
  <>
    <aside class="listen" data-listen aria-label={t(lang, 'listenSticky')}>
      <div class="listen__inner wrap">
        <div class="listen__glow" aria-hidden="true"></div>
        <div class="listen__lead">
          <div class="listen__meta">
            <span class="listen__kicker">{t(lang, 'listenSticky')}</span>
            <a class="listen__title" href={localRoute(lang, episode.route)}>{episode.title}</a>
          </div>
          {audio && <HaPlayer src={audio} compact lang={lang} />}
        </div>
        <div class="listen__side">
          {youtube && (
            <a class="listen__watch" href={`${localRoute(lang, episode.route)}#ep-watch`} data-listen-yt={youtube}>
              <span
                class="listen__watch-thumb"
                style={`background-image:url(https://i.ytimg.com/vi/${youtube}/mqdefault.jpg)`}
                aria-hidden="true"
              >
                <svg class="listen__watch-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.14v13.72L19 12 8 5.14z"/></svg>
              </span>
              <span class="listen__watch-label">{t(lang, 'watchOnPage')}</span>
            </a>
          )}
          <button type="button" class="listen__close" data-listen-close aria-label={t(lang, 'listenClose')}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6.4 5l5.6 5.6L17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4z"/></svg>
          </button>
        </div>
      </div>
    </aside>
    <script is:inline>
      (function(){
        var box=document.querySelector("[data-listen]"); if(!box)return;
        var key="haoma-listen-hide:"+location.pathname;
        var btn=box.querySelector("[data-listen-close]");
        var root=document.documentElement;
        function syncPad(){
          if(box.hidden){root.style.removeProperty("--listen-h"); return;}
          root.style.setProperty("--listen-h", Math.ceil(box.getBoundingClientRect().height)+"px");
        }
        if(btn)btn.onclick=function(){box.hidden=true; syncPad(); try{sessionStorage.setItem(key,"1")}catch(e){}};
        try{if(sessionStorage.getItem(key)==="1")box.hidden=true}catch(e){}
        syncPad();
        if(typeof ResizeObserver!=="undefined"){new ResizeObserver(syncPad).observe(box);}
        else{window.addEventListener("resize",syncPad);}
      })();
    </script>
  </>
)}
