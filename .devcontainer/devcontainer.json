{
  "name": "Haoma - Hugo + site editor",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "sh .devcontainer/setup-hugo.sh",
  "portsAttributes": {
    "8765": {
      "label": "Haoma editor",
      "onAutoForward": "openBrowser",
      "visibility": "public",
      "requireLocalPort": true
    },
    "1313": {
      "label": "Hugo preview",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postAttachCommand": {
    "editor": "sh .devcontainer/start-editor.sh"
  }
}
